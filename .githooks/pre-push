#!/usr/bin/env sh

set -eu

[ -n "${CRM_SKIP_HOOKS:-}" ] && exit 0

deleting_only=1
while read -r _local_ref local_sha _remote_ref _remote_sha; do
	case "$local_sha" in
	0000000000000000000000000000000000000000) ;;
	*) deleting_only=0 ;;
	esac
done
[ "$deleting_only" = "1" ] && exit 0

fail() {
	echo ""
	echo "  \`bun run $1\` failed, so this push would have failed CI."
	echo "  Fix it, or push anyway with --no-verify."
	echo ""
	exit 1
}

resolve_bun() {
	if [ -n "${CRM_BUN:-}" ] && [ -x "$CRM_BUN" ]; then
		printf '%s\n' "$CRM_BUN"
		return
	fi
	if command -v bun >/dev/null 2>&1; then
		command -v bun
		return
	fi
	if [ -n "${BUN_INSTALL:-}" ] && [ -x "$BUN_INSTALL/bin/bun" ]; then
		printf '%s\n' "$BUN_INSTALL/bin/bun"
		return
	fi
	if [ -x "$HOME/.bun/bin/bun" ]; then
		printf '%s\n' "$HOME/.bun/bin/bun"
		return
	fi
	echo "Bun was not found. Add it to PATH or set CRM_BUN to its executable path." >&2
	exit 1
}

bun_bin=$(resolve_bun)

for task in check-types lint lint:slop test; do
	echo "pre-push: bun run $task"
	"$bun_bin" run "$task" || fail "$task"
done
